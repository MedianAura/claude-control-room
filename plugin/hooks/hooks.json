{
  "description": "control-room : état des sessions pour le bandeau, approbations depuis la page, accusés de réception et relance de l'orchestratrice.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "status"], "async": true } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "status"], "async": true } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "status"], "async": true } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "status"], "async": true } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "status"], "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "stop"], "timeout": 15 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/control-room.js", "hook", "permission"], "timeout": 900 } ] }
    ]
  }
}
